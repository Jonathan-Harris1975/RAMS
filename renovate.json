{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "after 1:00am and before 3:30am on saturday"
  ],
  "rangeStrategy": "replace",
  "platformAutomerge": false,
  "minimumReleaseAge": "2 days",
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "labels": [
      "security",
      "dependency:auto-eligible"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 1:00am and before 3:30am on saturday"
    ],
    "automerge": false,
    "labels": [
      "dependency:auto-eligible"
    ]
  },
  "packageRules": [
    {
      "description": "Mark patch, minor and digest updates (Python, Docker, GitHub Actions) once the stability window and required checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:auto-eligible"
      ]
    },
    {
      "description": "Keep major updates under manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:manual"
      ]
    }
  ]
}
