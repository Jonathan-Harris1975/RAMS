{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "after 7am and before 8am on sunday"
  ],
  "rangeStrategy": "replace",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 7am and before 8am on sunday"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Python dependency updates require manual approval",
      "matchManagers": [
        "pip_requirements"
      ],
      "automerge": true
    },
    {
      "description": "Docker base image updates require manual approval",
      "matchManagers": [
        "dockerfile"
      ],
      "automerge": true
    },
    {
      "description": "GitHub Actions updates require manual approval",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    }
  ]
}
