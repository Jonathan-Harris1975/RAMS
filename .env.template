# ─────────────────────────────────────────────
# Repo Management Suite · Environment Template
# Copy to .env and fill in all required values.
# ─────────────────────────────────────────────

# ── Cloudflare R2 ────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_AUDITS=audits
R2_PUBLIC_BASE_URL_AUDITS=

# ── OpenRouter ───────────────────────────────
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=        # patch planning (e.g. anthropic/claude-3-5-sonnet)
OPENROUTER_SECONDARY_MODEL=      # fallback on 429 / 5xx
OPENROUTER_TRIAGE_MODEL=         # classification only — use a cheaper model

# ── Target repo paths ────────────────────────
# Absolute paths to local clones of each target repo.
RMS_SEO_REPO_PATH=               # abs path to AI-management-suite clone
RMS_WEBSITE_REPO_PATH=           # abs path to jonathan-harris-website clone

# ── Per-target validation commands ───────────
# Split on " && " into list[str] at runtime.
RMS_SEO_VALIDATION_COMMANDS=npm test && npm run build
RMS_WEBSITE_VALIDATION_COMMANDS=python3 scripts/inject_partials.py --validate && python3 scripts/sync_redirects.py --check && python3 scripts/check_crawlers.py

# ── Behaviour defaults ───────────────────────
RMS_DRY_RUN=true                 # SAFE DEFAULT — never omit
RMS_MAX_ISSUES_PER_RUN=5
RMS_REPORT_PREFIX=qa-suite/reports
RMS_QA_BRANCH_PREFIX=rms-qa/
RMS_PUSH_ENABLED=false
RMS_CREATE_PR=false
RMS_VALIDATE_AFTER_EACH_TASK=true
RMS_REVERT_ON_VALIDATION_FAILURE=true
RMS_SCHEDULE_CRON=0 3 * * *

# ── API server ───────────────────────────────
RMS_HOST=0.0.0.0
RMS_PORT=8000
LOG_LEVEL=info
