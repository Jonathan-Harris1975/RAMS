# ─────────────────────────────────────────────
# Repo Management Suite · Environment Template
# Copy to .env and fill in all required values.
# ─────────────────────────────────────────────

# ── Cloudflare R2 ────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_AUDITS=audits
R2_PUBLIC_BASE_URL_AUDITS=

# ── OpenRouter ───────────────────────────────
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=        # patch planning
OPENROUTER_SECONDARY_MODEL=      # fallback on 429 / 5xx
OPENROUTER_TRIAGE_MODEL=         # classification only — use a cheaper model

# ── Target repo paths ────────────────────────
# Current routing:
#   seo-aeo-geo -> website repo
#   mobile-ux   -> website repo
#   on-brand    -> AIMS / AI-management-suite repo
RMS_WEBSITE_REPO_PATH=/tmp/rams-repos/website
RMS_AIMS_REPO_PATH=/tmp/rams-repos/aims

# ── Optional Koyeb/runtime repo bootstrap ────
# Enable this when the target repos are not mounted into the container.
RMS_REPO_BOOTSTRAP_ENABLED=false
RMS_REPO_BASE_DIR=/tmp/rams-repos
RMS_WEBSITE_REPO_URL=
RMS_WEBSITE_REPO_BRANCH=main
RMS_AIMS_REPO_URL=
RMS_AIMS_REPO_BRANCH=main
# Either RMS_GITHUB_TOKEN or GITHUB_TOKEN may be used. Prefer RMS_GITHUB_TOKEN on Koyeb.
RMS_GITHUB_TOKEN=
GITHUB_TOKEN=

# ── Per-target validation commands ───────────
# Split on " && " into list[str] at runtime.
RMS_WEBSITE_VALIDATION_COMMANDS=python3 scripts/inject_partials.py --validate && python3 scripts/sync_redirects.py --check && python3 scripts/check_crawlers.py
RMS_AIMS_VALIDATION_COMMANDS=npm test && npm run build

# ── Behaviour defaults ───────────────────────
RMS_DRY_RUN=true                 # SAFE DEFAULT — never omit
RMS_LIVE_WRITE_ENABLED=false     # live writes also require RMS_DRY_RUN=false
RMS_MAX_ISSUES_PER_RUN=5
RMS_REPORT_PREFIX=qa-suite/reports
RMS_REPORT_DIR=/tmp/rams-reports # local dry-run/fallback reports
RMS_QA_BRANCH_PREFIX=rms-qa/
RMS_PUSH_ENABLED=false
RMS_CREATE_PR=false
RMS_VALIDATE_AFTER_EACH_TASK=true
RMS_REVERT_ON_VALIDATION_FAILURE=true
RMS_SINGLE_WORKER_MODE=true      # block live writes if multi-worker env is detected

# ── API server ───────────────────────────────
# Required before exposing protected endpoints. Only / and /health are public.
RMS_API_KEY=
# Local-only escape hatch for unauthenticated rebuild triggers. Keep false in production.
RMS_ALLOW_UNAUTHENTICATED_DEV=false
RMS_HOST=0.0.0.0
RMS_PORT=8000
LOG_LEVEL=info
