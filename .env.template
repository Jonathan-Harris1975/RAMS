# RAMS · Koyeb eco-micro environment template
# Target: 0.25 vCPU, 512MB RAM, 4GB ephemeral SSD, one instance.
# Copy the non-secret values to Koyeb and store secrets in Koyeb Secrets.

# ── Python / process limits ────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=random
MALLOC_ARENA_MAX=2
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
UV_THREADPOOL_SIZE=2
NODE_OPTIONS=--max-old-space-size=256
LOG_LEVEL=info

# ── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID={{ secret.R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ secret.R2_SECRET_ACCESS_KEY }}
R2_REGION=auto
R2_BUCKET_AUDITS=audits
R2_PUBLIC_BASE_URL_AUDITS=
R2_BUCKET_HIVE_SKILLS=hive-skills
R2_PUBLIC_BASE_URL_HIVE_SKILLS=

# ── OpenRouter model roles ────────────────────────────────────────────────
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY={{ secret.OPENROUTER_API_KEY }}
OPENROUTER_HTTP_REFERER=https://jonathan-harris.online
OPENROUTER_APP_NAME=RAMS
# Cost-effective repository reasoning; review against current OpenRouter availability before deployment.
OPENROUTER_PRIMARY_MODEL=anthropic/claude-opus-5
# Independent, stronger-priced fallback for retryable primary failures only.
OPENROUTER_SECONDARY_MODEL=anthropic/claude-sonnet-5
# Compact classification and routing.
OPENROUTER_TRIAGE_MODEL=anthropic/claude-sonnet-5

# ── OpenRouter transport, routing and cost controls ───────────────────────
RMS_OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
RMS_OPENROUTER_READ_TIMEOUT_SECONDS=90
RMS_OPENROUTER_WRITE_TIMEOUT_SECONDS=30
RMS_OPENROUTER_POOL_TIMEOUT_SECONDS=5
RMS_OPENROUTER_MAX_CONNECTIONS=2
RMS_OPENROUTER_MAX_KEEPALIVE_CONNECTIONS=1
RMS_OPENROUTER_KEEPALIVE_EXPIRY_SECONDS=30
# Zero internal retries by default: one model attempt, then one secondary fallback.
RMS_OPENROUTER_MAX_RETRIES=0
RMS_OPENROUTER_RETRY_BASE_SECONDS=1
RMS_OPENROUTER_RETRY_MAX_SECONDS=8
RMS_OPENROUTER_PROVIDER_SORT=price
RMS_OPENROUTER_ALLOW_FALLBACKS=true
# Keep repository content away from providers that may collect user data.
RMS_OPENROUTER_DATA_COLLECTION=deny
RMS_PRIMARY_MAX_TOKENS=3072
RMS_SECONDARY_MAX_TOKENS=3072
RMS_TRIAGE_MAX_TOKENS=128
RMS_PRIMARY_TEMPERATURE=0
RMS_TRIAGE_TEMPERATURE=0
RMS_TOP_P=0.9
RMS_OPENROUTER_LOG_USAGE=true
RMS_OPENROUTER_LOG_COST=true
RMS_OPENROUTER_LOG_PROMPTS=false
RMS_HEADROOM_ENABLED=true
RMS_HEADROOM_TARGET_RATIO=0.7
RMS_HEADROOM_MIN_TOKENS_TO_COMPRESS=250
RMS_HEADROOM_MAX_INPUT_CHARS=262144
RMS_HEADROOM_KOMPRESS_MODEL=disabled
RMS_HEADROOM_LOG_SAVINGS=true

# ── Target repository mapping ─────────────────────────────────────────────
# website is the primary unified website-remediation pipeline and uses the website repository.
# seo-aeo-geo and mobile-ux remain legacy compatibility lanes only.
# on-brand uses the AIMS / AI-management-suite repository.
RMS_WEBSITE_REPO_PATH=/tmp/rams-repos/website
RMS_AIMS_REPO_PATH=/tmp/rams-repos/aims

# ── Optional ephemeral-repo bootstrap ────────────────────────────────────
RMS_REPO_BOOTSTRAP_ENABLED=true
RMS_REPO_BASE_DIR=/tmp/rams-repos
RMS_WEBSITE_REPO_URL={{ secret.RMS_WEBSITE_REPO_URL }}
RMS_WEBSITE_REPO_BRANCH=main
RMS_AIMS_REPO_URL={{ secret.RMS_AIMS_REPO_URL }}
RMS_AIMS_REPO_BRANCH=main
# Prefer RMS_GITHUB_TOKEN. The token must have Contents: Read and write and
# Pull requests: Read and write for repositories RAMS is allowed to remediate.
# GITHUB_TOKEN remains a compatibility alias.
RMS_GITHUB_TOKEN={{ secret.GITHUB_TOKEN_WEBSITE_AUDITS }}
GITHUB_TOKEN=
RMS_GITHUB_API_BASE=https://api.github.com
RMS_GITHUB_API_TIMEOUT_SECONDS=20
RMS_GITHUB_API_MAX_RETRIES=2
RMS_GIT_CLONE_DEPTH=1
RMS_GIT_TIMEOUT_SECONDS=120
RMS_GIT_OUTPUT_MAX_BYTES=65536

# ── Per-target validation commands ───────────────────────────────────────
# Commands remain sequential. Do not add npm install/ci here on eco-micro.
RMS_WEBSITE_VALIDATION_COMMANDS=python3 scripts/inject_partials.py --validate && python3 scripts/sync_redirects.py --check && python3 scripts/check_crawlers.py
RMS_AIMS_VALIDATION_COMMANDS=npm test && npm run build
RMS_VALIDATION_TIMEOUT_SECONDS=240
RMS_VALIDATION_OUTPUT_MAX_LINES=120
RMS_VALIDATION_OUTPUT_MAX_BYTES=131072

# ── eco-micro admission and resource ceilings ───────────────────────────
RMS_MAX_CONCURRENT_PIPELINES=1
RMS_MAX_ISSUES_PER_RUN=3
# Unified website audit: 0 means process every eligible Confirmed code_fix in the council ledger.
RMS_WEBSITE_MAX_ISSUES_PER_RUN=5
RMS_MAX_AUDIT_ARTEFACTS=8
RMS_MAX_AUDIT_OBJECT_BYTES=1048576
RMS_MAX_AUDIT_TOTAL_BYTES=4194304
RMS_MAX_CONTEXT_FILES=8
RMS_MAX_CONTEXT_FILE_BYTES=131072
RMS_MAX_CONTEXT_TOTAL_BYTES=524288
RMS_MAX_INDEXED_FILES=20000
RMS_REPORT_MAX_BYTES=4194304
RMS_MIN_FREE_DISK_MB=256
RMS_TEMP_CLEANUP_ENABLED=true
RMS_TEMP_MAX_AGE_HOURS=24
RMS_READINESS_CACHE_SECONDS=300
RMS_IDEMPOTENCY_CACHE_SIZE=128
RMS_BUSY_RETRY_AFTER_SECONDS=60
RMS_SHUTDOWN_GRACE_SECONDS=25

# ── Behaviour and safety gates ───────────────────────────────────────────
# Production contract: validated changes are committed only on rms-qa/* branches,
# pushed automatically, then published as one non-draft GitHub PR per run.
# Use .env.example-dry-run for a non-writing deployment.
RMS_DRY_RUN=false
RMS_LIVE_WRITE_ENABLED=true
RMS_REPORT_PREFIX=qa-suite/reports
RMS_REPORT_DIR=/tmp/rams-reports
RMS_QA_BRANCH_PREFIX=rms-qa/
RMS_PUSH_ENABLED=true
RMS_CREATE_PR=true
RMS_VALIDATE_AFTER_EACH_TASK=true
RMS_REVERT_ON_VALIDATION_FAILURE=true
RMS_SINGLE_WORKER_MODE=true

# ── API server ────────────────────────────────────────────────────────────
# Only / and /health are public. /ops/warmup is authenticated and performs no external work.
RMS_API_KEY={{ secret.RMS_API_KEY }}
RMS_ALLOW_UNAUTHENTICATED_DEV=false
RMS_HOST=0.0.0.0
RMS_PORT=8000

# ── Professional operations and HIVE Ops alerts ───────────────────────────
RMS_R2_VERIFY_INTERVAL_SECONDS=900
RMS_REPORT_RETENTION_DAYS=180
RMS_RELEASE_ID={{ secret.RMS_RELEASE_ID }}
OPS_ALERT_WEBHOOK_URL={{ secret.OPS_ALERT_WEBHOOK_URL }}
OPS_ALERT_WEBHOOK_TOKEN={{ secret.OPS_EVENT_INGEST_TOKEN }}
OPS_ALERT_TIMEOUT_SECONDS=8

# Autonomous engineering council / micro-surgery constitution
RMS_ENGINEERING_COUNCIL_ENABLED=true
RMS_ENGINEERING_COUNCIL_ARCHITECT_MODEL=anthropic/claude-opus-5
RMS_ENGINEERING_COUNCIL_SPECIALIST_MODEL=anthropic/claude-sonnet-5
RMS_ENGINEERING_COUNCIL_CHAIR_MODEL=anthropic/claude-opus-5
RMS_AUTONOMOUS_MAX_FILES=3
RMS_AUTONOMOUS_MAX_CHANGES=6
RMS_AUTONOMOUS_MAX_REPLACE_CHARS=8000
RMS_AUTONOMOUS_ALLOW_DEPENDENCY_CHANGES=false
RMS_AUTONOMOUS_ALLOW_CONFIG_CHANGES=false
