{
  "repository_id": "RAMS",
  "github_repository": "Jonathan-Harris1975/RAMS",
  "ecosystem_manager": "HIVE",
  "role": "governed_repository",
  "readiness_authority": "deterministic_ci_security_deployment_runtime_gates",
  "remediation_executor": "Kilo",
  "technical_escalation": "CTO",
  "human_authority": "owner",
  "autonomous_actions": [
    "observe",
    "validate",
    "gate",
    "report",
    "bounded_repair_pr",
    "deployment_verification"
  ],
  "owner_only_triggers": [
    "secrets_or_credentials",
    "irreversible_production_action",
    "security_policy_exception",
    "legal_or_commercial_decision",
    "destructive_data_operation"
  ],
  "certification_rule": "The remediation executor must not certify its own repair. Repository gates and live verification remain authoritative.",
  "gate_catalogue_authority": "hive:production-manager"
}
